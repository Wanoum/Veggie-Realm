{
  "functions": {
    "api/export-recipe.js": {
      "includeFiles": "Krylon.otf"
    },
    "api/card-images.js": {
      "includeFiles": "src/card-*.svg"
    }
  },
  "headers": [
    {
      "source": "/(index.html|sw.js|tokens.css|components.css|pages.css)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    }
  ]
}
